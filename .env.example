# Where a browser first finds Lucent. The setup narrows the address later.
LUCYA_PORT=8060
LUCYA_BIND=0.0.0.0

# stable follows main (the pre-release until Aperture is done); beta
# follows the beta/* branches, where work lands first.
LUCYA_CHANNEL=stable

# Host folders a container may get, comma-separated: Aperture's photos.
# Without one, Aperture cannot be chosen.
LUCYA_ALLOWED_PATHS=/srv/fotos

# Backups: a named volume by default; or a folder on the host.
#LUCYA_BACKUP_PATH=/srv/backup

TZ=Europe/Berlin

# Only for a second stack beside the real one (tests):
#LUCYA_PREFIX=test-
#LUCYA_NETWORK=test-lucya
#LUCYA_CONTROL_NETWORK=test-lucya-aio
#LUCYA_PORT=28060
